# ─────────────────────────────────────────────────────────────
#  CANOPEA — Variables de entorno
#  Copia este archivo como .env.local y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Firebase (obligatorio para datos reales, opcional para modo demo)
NEXT_PUBLIC_FIREBASE_API_KEY=TU_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ─────────────────────────────────────────────────────────────
# NOTAS:
#   • Sin estas variables, el dashboard funciona en MODO DEMO
#     con datos simulados generados cada 4 segundos.
#   • Las variables NEXT_PUBLIC_* son visibles en el navegador.
#     NUNCA incluyas secretos del servidor aquí.
#   • Obtén los valores en:
#     https://console.firebase.google.com → Tu proyecto → Configuración de la app
# ─────────────────────────────────────────────────────────────
